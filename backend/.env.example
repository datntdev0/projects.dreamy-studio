# Copy to backend/.env. Variables already set in the environment take precedence.

DREAMY_BACKEND_PORT=8765
# dev | test | prod
DREAMY_BACKEND_RUN_MODE=dev
DREAMY_BACKEND_LOG_DIR=../_output/backend/logs
DREAMY_BACKEND_DATA_DIR=../_output/backend/data
# cpu | cuda
DREAMY_BACKEND_DEVICE=cpu

# When set, every request must send the header "X-API-Key: <value>".
DREAMY_BACKEND_API_KEY=

# DREAMY_BACKEND_WORKER_PYTHON=
# DREAMY_BACKEND_PYPI_URL=https://pypi.org
# DREAMY_BACKEND_NVIDIA_SMI=nvidia-smi
# DREAMY_BACKEND_WHEEL_MIRROR=
# DREAMY_BACKEND_TTS_ENGINE=
