{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dreamy Studio",
  "version": "0.0.0",
  "identifier": "com.datntdev.dreamy-studio",
  "build": {
    "beforeDevCommand": "pnpm run angular:serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run angular:build",
    "frontendDist": "../_output/angular/dist/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Dreamy Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 540,
        "visible": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
