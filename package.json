{
  "name": "dreamy-studio",
  "version": "0.1.0",
  "scripts": {
    "ffmpeg:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/scripts/fetch-ffmpeg.ps1",
    "start": "tauri dev",
    "seed:proto": "pnpm --filter dreamy-studio-verify run seed:proto",
    "start:proto": "pnpm --filter dreamy-studio-verify run start:proto",
    "build": "tauri build",
    "tauri": "tauri",
    "test": "cargo test --manifest-path desktop/Cargo.toml --target-dir _output/desktop/target",
    "angular:serve": "pnpm --filter dreamy-studio-angular run serve",
    "angular:build": "pnpm --filter dreamy-studio-angular run build",
    "story": "pnpm --filter dreamy-studio-angular run story",
    "story:build": "pnpm --filter dreamy-studio-angular run story:build"
  },
  "private": true,
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "packageManager": "pnpm@12.16.1"
}
