{
  "name": "dreamy-studio",
  "version": "0.1.0",
  "scripts": {
    "build:prepare": "node _scripts/build_prepare.mjs",
    "start": "tauri dev",
    "build": "tauri build",
    "build:portable": "node _scripts/build_portable.mjs",
    "build:installer": "node _scripts/build_installer.mjs",
    "tauri": "tauri",
    "test:desktop": "cargo test --manifest-path desktop/Cargo.toml --target-dir _output/desktop/target",
    "test:angular": "pnpm --filter dreamy-studio-angular run test",
    "playwright:build": "pnpm --filter dreamy-studio-playwright run build:app",
    "playwright:test": "pnpm --filter dreamy-studio-playwright run test",
    "angular:serve": "pnpm --filter dreamy-studio-angular run serve",
    "angular:build": "pnpm --filter dreamy-studio-angular run build",
    "story": "pnpm --filter dreamy-studio-angular run story",
    "story:build": "pnpm --filter dreamy-studio-angular run story:build",
    "coverage:desktop": "node _scripts/coverage_desktop.mjs",
    "coverage:angular": "node _scripts/coverage_angular.mjs",
    "format": "node _scripts/format.mjs",
    "format:fix": "node _scripts/format.mjs --fix",
    "lint": "node _scripts/lint.mjs",
    "lint:fix": "node _scripts/lint.mjs --fix"
  },
  "private": true,
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2"
  },
  "packageManager": "pnpm@12.16.1"
}
