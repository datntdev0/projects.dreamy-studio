{
  "name": "dreamy-studio",
  "version": "0.0.0",
  "scripts": {
    "build:prepare": "node _scripts/build_prepare.mjs",
    "start": "tauri dev",
    "build": "tauri build",
    "build:portable": "node _scripts/build_portable.mjs",
    "build:installer": "node _scripts/build_installer.mjs",
    "tauri": "tauri",
    "test": "cargo test --manifest-path desktop/Cargo.toml --target-dir _output/desktop/target",
    "verify:build": "pnpm --filter dreamy-studio-verify run build:app",
    "verify:test": "pnpm --filter dreamy-studio-verify run test",
    "angular:serve": "pnpm --filter dreamy-studio-angular run serve",
    "angular:build": "pnpm --filter dreamy-studio-angular run build",
    "story": "pnpm --filter dreamy-studio-angular run story",
    "story:build": "pnpm --filter dreamy-studio-angular run story:build"
  },
  "private": true,
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "yaml": "^2"
  },
  "packageManager": "pnpm@12.16.1"
}
