{
  "name": "dreamy-studio-playwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright verification of the Dreamy Studio desktop app",
  "scripts": {
    "build:app": "pnpm --dir .. run build --debug --no-bundle",
    "test": "playwright test --project=desktop",
    "report": "playwright show-report ../_output/playwright/report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
